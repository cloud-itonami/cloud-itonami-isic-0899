{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM).
 ;; Pinned by git/sha so this repo is standalone-forkable (no
 ;; monorepo-relative :local/root assumption) -- ISIC-0899 needs no
 ;; robotics (blueprint.edn :itonami.blueprint/robotics false: this
 ;; is a back-office coordination actor, never a physical-actuation
 ;; one).
 :deps {
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "f7b3fca8e08147ae7d658fe36ae0475a45fb76a9"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:git/sha "a332a770a0d2b5193f81b54483bb954fb29ef8d7"}
        ;; jp-go-digital-design-system (DADS) -- the workspace BASE design
        ;; system (com-junkawasaki/root CLAUDE.md, 2026-08-05). Supplies the
        ;; single inlined <style> block `quarryops.render-html` writes into
        ;; the generated operator console, so the sample page needs no
        ;; external asset. Same git-coordinate (not :local/root) form as
        ;; langgraph above, so a standalone fork still resolves it.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "cc8f4849af5def7ea535fd6c0b8a623ccca645e9"}}
 :aliases
 {;; monorepo-internal dev -- pin transitive langgraph/langchain to
  ;; local checkouts when working inside the com-junkawasaki superproject.
  :dev {:override-deps
        {io.github.kotoba-lang/langgraph
         {:local/root "../../kotoba-lang/langgraph"}
         io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "quarryops.sim"]}
  ;; kbb -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by driving the REAL actor
  ;; (advisor -> governor -> phase gate -> store) at build time.
  :render-html {:main-opts ["-m" "quarryops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
